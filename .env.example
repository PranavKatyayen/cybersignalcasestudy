# Copy this file to .env and fill in real values.
# .env itself is gitignored -- NEVER commit real credentials.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your_account_identifier_here
SNOWFLAKE_USER=your_username_here
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=CYBERSIGNAL_WH
SNOWFLAKE_DATABASE=CYBERSIGNAL
SNOWFLAKE_SCHEMA=RAW

# --- LLM providers (set at least one; free tiers work) ---
# Groq: console.groq.com  |  Gemini: aistudio.google.com  |  Anthropic (paid): console.anthropic.com
# Defaults: org_classification and risk_narrative both use Gemini. Override per skill with e.g.
#   LLM_PROVIDER_RISK_NARRATIVE=groq    or force one provider for everything with LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
ANTHROPIC_API_KEY=
